{
  "name": "sxxw-official-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "上海树下小屋网络科技有限公司官网",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "seo:submit": "node scripts/submit-indexnow.mjs",
    "seo:check": "node --test scripts/legacy-timetrails.test.mjs scripts/legacy-timetrails-guides.test.mjs && node scripts/check-seo.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
